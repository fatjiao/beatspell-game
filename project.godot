; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="One Person Band Demo"
config/description="A light four-instrument rhythm game prototype."
config/icon="res://icon.svg"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

instrument_drums={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68,"unicode":100), Object(InputEventJoypadButton,"button_index":2)]
}
instrument_bass={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70,"unicode":102), Object(InputEventJoypadButton,"button_index":3)]
}
instrument_synth={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":74,"unicode":106), Object(InputEventJoypadButton,"button_index":0)]
}
instrument_lead={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":75,"unicode":107), Object(InputEventJoypadButton,"button_index":1)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

