; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="Beatspell Boss Demo"
config/description="An original rhythm-spell boss battle prototype."
config/version="0.3.0-internal"
config/icon="res://icon.svg"
run/main_scene="res://scenes/beatspell/beatspell_battle.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[input]

battle_charge={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68,"unicode":100), Object(InputEventKey,"physical_keycode":70,"unicode":102), Object(InputEventJoypadButton,"button_index":2), Object(InputEventJoypadButton,"button_index":3)]
}
battle_cast={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":74,"unicode":106), Object(InputEventKey,"physical_keycode":75,"unicode":107), Object(InputEventJoypadButton,"button_index":0), Object(InputEventJoypadButton,"button_index":1)]
}

instrument_drums={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68,"unicode":100), Object(InputEventJoypadButton,"button_index":2)]
}
instrument_bass={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70,"unicode":102), Object(InputEventJoypadButton,"button_index":3)]
}
instrument_synth={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":74,"unicode":106), Object(InputEventJoypadButton,"button_index":0)]
}
instrument_lead={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":75,"unicode":107), Object(InputEventJoypadButton,"button_index":1)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
